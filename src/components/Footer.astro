---
import { SITE_NAME, NAV, CONTACT_EMAIL } from '../config';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div
    class="wrap flex flex-col gap-6 py-10 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {SITE_NAME}</p>

    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {NAV.map(({ label, href }) => <a href={href} class="hover:text-ink">{label}</a>)}
      <a href="/rss.xml" class="hover:text-ink">RSS</a>
      <a href="/privacy" class="hover:text-ink">Privacy</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-ink">Email</a>
    </nav>
  </div>
</footer>
