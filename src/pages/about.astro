---
import Base from '../layouts/Base.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../config';
---

<Base title="About" description={`About ${SITE_NAME}.`}>
  <article class="pt-14 pb-8 sm:pt-20">
    <header class="wrap-prose">
      <h1 class="text-[2.25rem] sm:text-[3rem]">About</h1>
      <hr class="mt-8 border-rule" />
    </header>

    <div class="wrap-prose prose-note mt-8">
      <p>
        Hi, I'm Eric, an analytics professional by day, and a&hellip;well&hellip;somebody who
        makes other data stuff by night. This website is a personal project that aims to
        highlight some fun things buried in the numbers. Please reach out at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </article>
</Base>
