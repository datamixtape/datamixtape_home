---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { getFeed } from '../lib/feed';
import { SITE_NAME } from '../config';

const feed = await getFeed();

// Every live tool, newest first. The newest leads full width; the rest sit three
// across beneath it. Posts live on the blog page.
const tools = feed.flatMap((e) =>
  e.kind === 'project' && e.project.status === 'live' ? [{ project: e.project, date: e.date }] : [],
);
const [newest, ...rest] = tools;
---

<Base>
  {/* The header already names the site; the h1 is for screen readers and search. */}
  <h1 class="sr-only">{SITE_NAME}</h1>

  <div class="wrap pt-10">
    {newest && <ToolCard {...newest} lead />}

    {
      rest.length > 0 && (
        <div class="mt-10 grid gap-x-7 gap-y-10 border-t border-rule pt-8 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((tool) => (
            <ToolCard {...tool} />
          ))}
        </div>
      )
    }
  </div>
</Base>
