---
import Base from '../layouts/Base.astro';
import FeedEntry from '../components/FeedEntry.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getFeed } from '../lib/feed';
import { SITE_TAGLINE } from '../config';

const feed = await getFeed();
---

<Base>
  {/* Short on purpose. The feed is the page; the pitch is on /about. */}
  <section class="wrap-prose pt-14 pb-8 sm:pt-20">
    <h1 class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">{SITE_TAGLINE}</h1>
    <p class="mt-4 text-lg text-ink-soft">
      Something new most weeks. Newest first.
    </p>
  </section>

  <div class="wrap-prose">
    {feed.map((entry) => <FeedEntry entry={entry} />)}
  </div>

  <div class="wrap-prose mt-14">
    <EmailCapture />
  </div>
</Base>
