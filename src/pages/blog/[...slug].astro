---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { projects } from '../../data/projects';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, kind, project: projectSlug } = post.data;
const project = projects.find((p) => p.slug === projectSlug);
---

<Base title={title} description={description}>
  <article class="pt-14 pb-8 sm:pt-20">
    <header class="wrap-prose">
      <div class="flex flex-wrap items-center gap-3 text-xs text-ink-muted">
        <span
          class="rounded-full border border-rule-strong px-2 py-0.5 font-medium tracking-wide text-ink-soft"
          >{kind}</span
        >
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          project && (
            <span>
              on{' '}
              {project.href ? (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener"
                  class="underline"
                  style={`color:${project.accent}`}
                >
                  {project.name}
                </a>
              ) : (
                <span style={`color:${project.accent}`}>{project.name}</span>
              )}
            </span>
          )
        }
      </div>

      <h1 class="mt-3 text-[2.1rem] leading-[1.15] sm:text-[2.75rem]">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{description}</p>
      <hr class="mt-8 border-rule" />
    </header>

    <div class="wrap-prose prose-note mt-8">
      <Content />
    </div>
  </article>

  <div class="wrap-prose mt-14">
    <EmailCapture />
  </div>

  <div class="wrap-prose mt-8">
    <a href="/blog" class="text-sm text-ink-muted hover:text-ink">&larr; All posts</a>
  </div>
</Base>
