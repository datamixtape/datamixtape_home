---
import Base from '../layouts/Base.astro';
import FeedEntry from '../components/FeedEntry.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getFeed } from '../lib/feed';

const feed = await getFeed();
---

<Base>
  {/* One short line; the feed is the page and the pitch is on /about. */}
  <section class="wrap-prose pt-14 pb-6 sm:pt-20">
    <h1 class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">Fun with Data</h1>
  </section>

  <div class="wrap-prose">
    {feed.map((entry) => <FeedEntry entry={entry} />)}
  </div>

  <div class="wrap-prose mt-14">
    <EmailCapture />
  </div>
</Base>
