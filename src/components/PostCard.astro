---
import { formatDate } from '../lib/posts';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  kind: string;
}

const { slug, title, description, date, kind } = Astro.props;
---

<article class="group border-b border-rule py-7 first:pt-0">
  <div class="flex items-center gap-3 text-xs text-ink-muted">
    <span
      class="rounded-full border border-rule-strong px-2 py-0.5 font-medium tracking-wide text-ink-soft"
      >{kind}</span
    >
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>

  <h3 class="mt-2.5 text-[1.4rem] leading-snug">
    <a href={`/blog/${slug}`} class="text-ink group-hover:text-accent">{title}</a>
  </h3>

  <p class="mt-1.5 max-w-prose text-[0.9375rem] leading-relaxed text-ink-soft">
    {description}
  </p>
</article>
