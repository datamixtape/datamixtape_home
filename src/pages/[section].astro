---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import { SECTIONS, type ProjectSection } from '../data/projects';

export const getStaticPaths = (() =>
  Object.keys(SECTIONS).map((section) => ({ params: { section } }))) satisfies GetStaticPaths;

const section = Astro.params.section as ProjectSection;
const { heading } = SECTIONS[section];
---

<Base title={heading}>
  <section class="wrap-prose flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="text-lg text-ink-soft">More coming soon.</p>
  </section>
</Base>
