---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page isn't here.">
  <section class="wrap flex flex-col items-start py-28 sm:py-36">
    <p class="text-sm tracking-[0.09em] text-ink-muted uppercase">404</p>
    <h1 class="mt-3 text-[2.25rem] sm:text-[3rem]">Nothing at this address</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-soft">
      The page either moved or never existed. Both happen.
    </p>
    <a
      href="/"
      class="mt-7 rounded-lg bg-accent px-5 py-2.5 text-[0.9375rem] font-medium text-paper hover:opacity-90"
    >
      Back to the front
    </a>
  </section>
</Base>
