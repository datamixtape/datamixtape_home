---
import Base from '../layouts/Base.astro';
import FeedEntry from '../components/FeedEntry.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { getFeed } from '../lib/feed';
import { SITE_NAME } from '../config';

const feed = await getFeed();
---

<Base>
  {/* No hero: the feed is the page; the pitch is on /about. */}
  <h1 class="sr-only">{SITE_NAME}</h1>

  <div class="wrap-prose pt-10 sm:pt-14">
    {feed.map((entry) => <FeedEntry entry={entry} />)}
  </div>

  <div class="wrap-prose mt-14">
    <EmailCapture />
  </div>
</Base>
