---
import { SITE_NAME, NAV } from '../config';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');

const active = (item: (typeof NAV)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);

/*
  One bar: the name on the left, set well above everything else in it, and the
  nav on the right. A black rule closes it off. On phones the nav drops under
  the name and wraps.
*/
const link = (on: boolean) => [
  'inline-block border-b-2 py-1 transition-colors',
  on ? 'border-ink text-ink' : 'border-transparent text-ink-soft hover:text-ink',
];
---

<header class="wrap">
  <div
    class="flex flex-col gap-3 border-b border-ink pt-6 pb-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
  >
    <a href="/" class="flex flex-none items-center gap-3 text-ink">
      <Logo size={40} />
      <span
        class="font-display text-[2.1rem] leading-none font-extrabold tracking-[-0.035em] sm:text-[2.75rem]"
      >
        {SITE_NAME}
      </span>
    </a>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[0.9375rem] font-semibold" aria-label="Main">
      {
        NAV.map((item) =>
          item.children?.length ? (
            <div class="group relative">
              <a href={item.href} class:list={link(active(item))}>
                {item.label}
                <span class="ml-0.5 text-[0.6rem] text-ink-muted" aria-hidden="true">▾</span>
              </a>

              <div class="invisible absolute top-full left-0 z-10 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 sm:right-0 sm:left-auto">
                <ul class="min-w-48 rounded-lg border border-rule bg-paper py-1.5 shadow-[0_6px_24px_rgba(0,0,0,0.1)]">
                  {item.children.map((child) => {
                    const external = child.href.startsWith('http');
                    return (
                      <li>
                        <a
                          href={child.href}
                          {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                          class:list={[
                            'block px-3.5 py-1.5 text-sm font-medium hover:bg-accent-soft hover:text-ink',
                            isActive(child.href) ? 'text-ink' : 'text-ink-soft',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={link(active(item))}>
              {item.label}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>
