---
import { SITE_NAME, NAV } from '../config';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');

const active = (item: (typeof NAV)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---

<header class="bg-ink">
  <div class="mx-auto flex w-full max-w-[68rem] items-center gap-2 px-6">
    <a
      href="/"
      class="mr-3 flex flex-none items-center gap-2 py-2.5 font-display text-sm font-medium leading-none text-[rgba(250,248,244,0.85)] hover:text-[rgba(250,248,244,1)]"
    >
      <Logo size={24} class="text-[rgba(250,248,244,0.85)]" />
      {SITE_NAME}
    </a>

    <nav class="flex items-center gap-0.5 text-sm">
      {
        NAV.map((item) =>
          item.children?.length ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  'inline-block border-b-2 px-2.5 py-2.5 transition-colors',
                  active(item)
                    ? 'border-accent text-[rgba(250,248,244,0.92)]'
                    : 'border-transparent text-[rgba(250,248,244,0.45)] hover:text-[rgba(250,248,244,0.7)]',
                ]}
              >
                {item.label}
              </a>

              <div class="invisible absolute top-full left-0 z-10 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="min-w-44 rounded-lg border border-rule bg-paper-raised py-1.5 shadow-[0_4px_20px_rgba(28,26,23,0.12)]">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block px-3.5 py-1.5 text-sm hover:bg-accent-soft hover:text-ink',
                          isActive(child.href) ? 'text-ink' : 'text-ink-soft',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'inline-block border-b-2 px-2.5 py-2.5 transition-colors',
                active(item)
                  ? 'border-accent text-[rgba(250,248,244,0.92)]'
                  : 'border-transparent text-[rgba(250,248,244,0.45)] hover:text-[rgba(250,248,244,0.7)]',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>
