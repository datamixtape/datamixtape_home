---
import Base from '../../layouts/Base.astro';

const appUrl = 'https://the-blind-board.vercel.app';
---

<Base
  title="The Blind Board"
  description="Mock-draft NBA prospects with the names stripped off. Pick on the numbers, then find out who you took."
>
  <iframe
    src={appUrl}
    title="The Blind Board"
    class="blind-board-frame"
    allow="clipboard-write"
  ></iframe>
</Base>

<style>
  .blind-board-frame {
    width: 100%;
    height: calc(100vh - 44px);
    border: none;
    display: block;
  }
</style>
