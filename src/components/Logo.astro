---
/**
 * The Data Mixtape mark (mark 27): an angled trend line with an open-chevron
 * arrowhead, tape reels, and a level bottom rule. The trend line says "data";
 * the reels say "mixtape"; the arrow says "up."
 *
 * Two tunings: below ~24px the stroke goes heavier and the geometry opens up.
 * Inherits `currentColor`, so it picks up link hover states for free.
 */
interface Props {
  /** Rendered height in px. The mark is square. */
  size?: number;
  class?: string;
}

const { size = 30, class: klass } = Astro.props;
const small = size < 24;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width={small ? 4 : 3}
  aria-hidden="true"
  class:list={['shrink-0', klass]}
>
  {
    small ? (
      <>
        <line x1="5.5" y1="11" x2="33.5" y2="6.5" stroke-linecap="round" />
        <polyline points="29,5 33.5,6.5 30,9.5" fill="none" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="12.2" cy="20" r="4.9" />
        <line x1="17.3" y1="20" x2="22.7" y2="20" />
        <circle cx="27.8" cy="20" r="4.9" />
        <line x1="5.5" y1="32.5" x2="34.5" y2="32.5" stroke-linecap="round" />
      </>
    ) : (
      <>
        <line x1="5" y1="10.4" x2="34" y2="5.9" stroke-linecap="round" />
        <polyline points="29.3,4.3 34,5.9 30,8.9" fill="none" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="12" cy="20" r="4.8" />
        <line x1="16.8" y1="20" x2="23.2" y2="20" />
        <circle cx="28" cy="20" r="4.8" />
        <line x1="5" y1="32" x2="35" y2="32" stroke-linecap="round" />
      </>
    )
  }
</svg>
